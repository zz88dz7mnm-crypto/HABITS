{
  "name": "StarkLab — Central de Comando Personal",
  "short_name": "StarkLab",
  "description": "Hábitos, finanzas, entrenamiento, diario y modo pausa. Todo en una web app instalable que funciona offline.",
  "start_url": "./?src=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0A0A0D",
